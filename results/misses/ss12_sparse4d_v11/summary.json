 "definitions": {
  "present": "ground-truth objects with a visible 2D box and a visible fraction above the presence threshold",
  "clearly_visible": "present objects with visible fraction >= 0.3 and truncated fraction <= 0.3 (question referent thresholds)",
  "paired": "the pipeline's 2D association (Hungarian on 2D IoU >= 0.3, class-agnostic) pairs a labelled box (a detection with a box from the source) with the object; views re-associated with rematch_view",
  "miss_causes": "no_detection: no detection overlaps the visible box at the threshold; unboxed: only detections without a box from the source do; assignment: a boxed detection does, but was assigned to another object",
  "range": "camera centre to ground-truth box centre (m), bins of scripts/compare_association.py",
  "wilson": "Wilson 95% interval (objects independent)",
  "bootstrap": "scene-cluster bootstrap 95% percentile interval (whole scenes resampled), overall rows only",
  "n_views": "views with at least one object of the group",
  "coverage": "questions with an automatic answer / questions; every unanswered question has a missed referent",
  "count_silent_miss": "a wrong automatic count with at least one missed instance of the class",
  "closest_open_world": "with the reference and >= --min-candidates candidates paired, answer among the paired candidates (a labeller offers only what it found)",
  "closest_silent_miss": "a wrong open-world closest-instance answer whose true answer object was missed",
  "flag_hit": "a flag overlapping (2D IoU >= 0.3) the visible box of a present object the flagged labeller missed",
  "flag_precision": "hits / flags",
  "flag_recall": "misses some flag hits / misses in the covered views",
  "unannotated_flag": "a flag overlapping no present ground-truth object at the threshold; NOT a false flag: ARKitScenes annotates 17 furniture classes and CuTR is class-agnostic, so many point at real objects without a box. n_unannotated_near counts those overlapping a present object at IoU >= near_iou (likely mislocalised)",
  "flaggable": "projected flags: a miss whose ground-truth box passes the same projection test",
  "cross_labeller": "witness boxes (CuTR) with no labelled box at 2D IoU >= 0.3, both directions; the reverse direction's labeller is the predictions set's raw boxes (source 'boxes')",
  "cross_frame": "the labeller's boxes from other views of the same static video, clustered in 3D, projected; kept if mostly inside the image and unoccluded by the view's iPad LiDAR depth (never laser)",
  "cross_camera": "the labeller's boxes from other cameras at the same frame index, projected; geometry only (no depth independent of the reference is stored)"
 },
