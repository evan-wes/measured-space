 "assumptions": [
  "Answers are reviewed in an order; a reviewed answer is corrected (delivered right), an unreviewed answer is delivered as it is.",
  "Every review costs the same human time, whatever the answer and whether it was right (--seconds); a rejected answer costs no more than a flagged one.",
  "Population: the answers the audit scored (gate.csv rows of the feature model). Unanswered questions (a referent had no box) are not answers; they are the miss review's subject. Answered questions the audit did not score (question types with too few scenes or rows, non-finite errors) are left out and counted in summary.json.",
  "Wrong: |auto - reference| > tau_scale * tau for numeric answers, a changed answer for categorical ones (gate.csv wrong_s). Categorical answers do not depend on the tolerance and are used as they are at every tau_scale.",
  "Combined queue: numeric and categorical answers interleaved by their rank fraction within their own kind, so reviewing the share f reviews the riskiest share f of each kind (the two scores are on different scales).",
  "Random review is its expected value, wrong_share * (1 - f); the ideal order reviews every wrong answer first.",
  "Scene-cluster bootstrap: whole scenes resampled with replacement, the orders kept as ranked on all answers; with few scenes (12 in the warehouse) the intervals are rough.",
  "Certified operating point: the gate's decisions as stored (thresholds certified per held-out scene by Learn-then-Test at epsilon, delta); flagged and rejected answers are reviewed. The combined accepted set inherits epsilon with confidence 1 - 2 delta (union bound). When a source is selected from an audit of several, the thresholds were certified on the sources pooled.",
  "Miss review: reviewing one flag costs the same time; a flag that hits a missed object recovers it; images are the views the flag kind covers (by == 'all' rows: every flag, no score or support filter)."
 ],
 "definitions": {
  "review_fraction": "share of answers reviewed",
  "residual_wrong_share": "wrong answers left unreviewed / all answers (the delivered set's wrong share)",
  "wrong_share": "wrong answers / all answers, before review",
  "order": "ours: feature model risk score (numeric sigma, categorical logistic), highest first; const: the constant baseline's score; random: expected value of a random order; ideal: wrong answers first",
  "lo, hi": "scene-cluster bootstrap 95% percentile interval",
  "minus_random": "review fraction minus random review's, with a paired bootstrap interval",
  "full_review_needed": "only reviewing every answer reaches the target",
  "certified_bound": "epsilon * accepted_share: the residual wrong share the gate's certificate allows",
  "random_review_fraction": "review fraction a random order needs to reach the gate's residual wrong share",
  "ranked_review_fraction": "review fraction the same model's ranking needs to reach the gate's residual (uncertified)",
  "minutes_<t>s": "human minutes per 1000 delivered answers (miss review: per 1000 images) at t seconds per review",
  "minutes_all_<t>s": "minutes per 1000 answers to review every answer",
  "tau_scale": "multiple of the question's tolerance a numeric answer must meet; *_tau columns use 1"
 },
 "notes": [
  "ark106_2d: source lidar of ['laser', 'lidar', 'moge']; the gate's thresholds were certified on the sources pooled",
  "ark106_2d/arkitscenes/categorical: 2 answered questions not scored by the audit are left out",
  "ark106_cutr_clip/arkitscenes/categorical: 1 answered questions not scored by the audit are left out"
 ],
